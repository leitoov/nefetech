RewriteEngine on

# Bloquear acceso web directo a archivos sensibles (.env, .git, etc.)
<FilesMatch "^(config\.php|\.env)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Pasar cabecera Authorization a PHP (Crucial para JWT en Apache)
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:CDN-LOOP} !cloudflare
RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} ^(www\.)?nefetech\.online
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,QSA]

# Redirigir https://nefetech.online/admin hacia https://admin.nefetech.online
RewriteCond %{HTTP_HOST} ^(www\.)?nefetech\.online$ [NC]
RewriteRule ^admin(/.*)?$ https://admin.nefetech.online/ [R=301,L]

# SPA Fallback for Nefetech
<IfModule mod_rewrite.c>
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

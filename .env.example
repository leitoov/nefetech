# Nefetech - Variables de Entorno del Backend (Ejemplo)

# Clave de Google Gemini API
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo de Gemini seleccionado (gemini-3.5-flash-lite / gemini-3.6-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Clave secreta para firma criptográfica de tokens JWT
JWT_SECRET=tu_secreto_jwt_largo_y_aleatorio

# Credenciales de acceso al panel administrador
ADMIN_EMAIL=admin@tudominio.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_password_admin_segura
